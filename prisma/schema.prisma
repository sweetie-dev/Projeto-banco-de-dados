generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String   @unique
  username   String
  password   String
  role       String   @default("user")
  created_at String   @default(cuid())

  @@map("users")
}

model Organizer {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  organization_name String?
  bio               String?
  website           String?
  created_at        String   @default(cuid())
  userId            String   @db.ObjectId @map("user_id")

  @@map("organizers")
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  created_at  String   @default(cuid())

  @@map("categories")
}

model Tag {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  created_at String   @default(cuid())

  @@map("tags")
}

model Location {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  address    String
  city       String
  state      String
  zip_code   String
  created_at String   @default(cuid())

  @@map("locations")
}

model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  start_date   String
  end_date     String
  price        Float
  capacity     Int
  created_at   String   @default(cuid())
  organizer_id String   @db.ObjectId
  location_id  String   @db.ObjectId
  category_id  String   @db.ObjectId
  tag_ids      String[] @db.ObjectId

  @@map("events")
}

model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  created_at String   @default(cuid())
  event_id   String   @db.ObjectId
  user_id    String   @db.ObjectId

  @@map("comments")
}

model Participation {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  status        String @default("pending")
  registered_at String @default(cuid())
  event_id      String @db.ObjectId
  user_id       String @db.ObjectId

  @@map("participations")
}

model Rating {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  score      Int
  comment    String?
  created_at String  @default(cuid())
  event_id   String  @db.ObjectId
  user_id    String  @db.ObjectId

  @@map("ratings")
}

model Notification {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  message    String
  read       Boolean @default(false)
  created_at String  @default(cuid())
  user_id    String  @db.ObjectId

  @@map("notifications")
}

model Food {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  price         Float
  image_url     String?
  display_order Int
  created_at    String  @default(cuid())
  userId        String  @db.ObjectId @map("user_id")

  @@map("foods")
}

model Sale {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  food_id        String @db.ObjectId
  payment_method String
  created_at     String @default(cuid())
  userId         String @db.ObjectId @map("user_id")

  @@map("sales")
}

model PixConfig {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  pix_key       String
  merchant_name String
  updated_at    String @default(cuid())
  userId        String @db.ObjectId @map("user_id")

  @@map("pix_config")
}
